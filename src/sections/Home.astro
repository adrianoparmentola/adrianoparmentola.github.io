---
// Home a capitoli, pensata per dire chi sono con poche parole: dati, foto,
// progetti. Lo scroll guida il racconto (reference: olhalazarieva.com).
// Flusso: billboard progetti → 01 profilo (nome e ruolo, tabella che si
// rompe, menù 3D e CV) → 02 design for hospitality (la tesi) → 03 progetti
// → 04 referenze. Un indice fisso "01 / 04" segue i capitoli.
// Animazioni: scripts/scrollfx.ts
import { Image } from 'astro:assets';
import TestimonialCard from '../components/TestimonialCard.astro';
import HeroBillboard from '../components/HeroBillboard.astro';
import SplitTitle from '../components/SplitTitle.astro';
import IdentityTable from '../components/IdentityTable.astro';
import ResumeBlock from '../components/ResumeBlock.astro';
import ThesisShowcase from '../components/ThesisShowcase.astro';
import { getCollection } from 'astro:content';
import { getProjectAsset } from '../lib/images';
import { profile } from '../lib/profile';
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const testimonials = await getCollection('testimonials');

// Capitoli-categoria: immagine, descrizione, pulsante -> ancora in Progetti
const CATEGORIES = [
  { key: 'servizi', image: getProjectAsset('safe-to-work', 'hero.webp') },
  { key: 'prodotti', image: getProjectAsset('cartesio', 'hero.webp') },
  { key: 'spazi', image: getProjectAsset('talea', 'hero.webp') },
] as const;
---

<HeroBillboard lang={lang} />

<div class="chapter-index" aria-hidden="true">
  <span class="ci-count"><span class="ci-num">01</span> / <span class="ci-tot">04</span></span>
  <span class="ci-name"></span>
</div>

<div data-chapter={t('id.chapter')}>
  <IdentityTable lang={lang} />
  <ResumeBlock lang={lang} />
</div>

<ThesisShowcase lang={lang} />

<section class="chapters" data-chapter={t('chapter.work')}>
  <SplitTitle text={t('chapter.work')} size="md" />
  <div class="chapter-list">
    {
      CATEGORIES.map((cat, i) => (
        <a class="chapter reveal" style={`--delay: ${i * 90}ms`} href={`/${lang}/projects/#${cat.key}`}>
          <div class="chapter-media">
            {cat.image && (
              <Image src={cat.image} alt={t(`cat.${cat.key}`)} widths={[480, 800, 1200]} sizes="(max-width: 900px) 100vw, 33vw" />
            )}
            <span class="num meta-tag">0{i + 1}</span>
          </div>
          <div class="chapter-body">
            <h3>{t(`cat.${cat.key}`)}</h3>
            <p>{t(`cat.${cat.key}.desc`)}</p>
            <span class="pill">{t('home.cta.explore')} →</span>
          </div>
        </a>
      ))
    }
  </div>
</section>

<section class="background" id="background" data-chapter={t('chapter.refs')}>
  <div class="bg-inner">
  <h2 class="reveal">{t('background.title')}</h2>

  <div class="testimonial-grid">
    {testimonials.map((tst, i) => (
      <div class="reveal" style={`--delay: ${i * 80}ms`}>
        <TestimonialCard testimonial={tst} />
      </div>
    ))}
  </div>

  <div class="facts">
    <div class="fact-block reveal">
      <h3>{t('background.languages')}</h3>
      <ul>
        {profile.languages.map((l) => <li>{l}</li>)}
      </ul>
    </div>
    <div class="fact-block reveal" style="--delay: 100ms">
      <h3>{t('background.gallup')}</h3>
      <ol class="gallup">
        {profile.gallupTop.map((g) => <li>{g}</li>)}
      </ol>
    </div>
  </div>
  </div>
</section>

<section class="contact-band reveal">
  <h2>{t('home.cta.contact')}</h2>
  <a class="cta primary" href={`/${lang}/contact/`}>{t('nav.contact')} →</a>
</section>

<script>
  import { initScrollFx } from '../scripts/scrollfx';
  initScrollFx();
  document.addEventListener('astro:page-load', initScrollFx);
</script>

<style>
  .cta {
    font-weight: var(--weight-bold);
    border: 1px solid currentColor;
    padding: 0.75rem 1.5rem;
    border-radius: 999px;
    transition: background 0.2s, color 0.2s, border-color 0.2s, transform 0.2s;
  }

  .cta.primary {
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: var(--color-text);
  }

  .cta.primary:hover {
    transform: translateY(-2px);
  }

  .cta.ghost {
    font-weight: var(--weight-regular);
  }

  .cta.ghost.dark:hover {
    background: var(--color-text);
    color: var(--color-bg);
  }

  /* ---------- Indice di capitolo fisso ----------
     Segue lo scroll: "01 / 05 — Chi sono". In difference si legge sia sul
     chiaro sia sul fondo scuro della tesi. */
  .chapter-index {
    position: fixed;
    left: var(--space-4);
    bottom: var(--space-4);
    z-index: 40;
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
    color: #fff;
    mix-blend-mode: difference;
    font-weight: var(--weight-bold);
    pointer-events: none;
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 0.35s, transform 0.35s;
  }

  .chapter-index:global(.show) {
    opacity: 1;
    transform: none;
  }

  .ci-count {
    font-size: var(--text-h3);
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
  }

  .ci-name {
    font-size: var(--text-meta);
    text-transform: uppercase;
    letter-spacing: 0.14em;
  }

  .chapter-index:global(.swap) .ci-num {
    display: inline-block;
    animation: ci-swap 0.4s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  @keyframes ci-swap {
    from {
      transform: translateY(60%);
      opacity: 0;
    }
  }

  /* ---------- Capitoli / categorie ---------- */
  .chapters {
    max-width: var(--content-max-width);
    margin: 0 auto;
    padding: var(--space-12) var(--space-4) var(--space-6);
  }

  .chapters :global(.split-title) {
    margin-bottom: var(--space-6);
  }

  .chapter-list {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-4);
  }

  .chapter {
    display: flex;
    flex-direction: column;
    color: var(--color-text);
    border: 1px solid var(--color-border);
    border-radius: 14px;
    overflow: hidden;
    transition: border-color 0.25s, transform 0.25s, box-shadow 0.25s;
  }

  .chapter:hover {
    border-color: var(--color-accent);
    transform: translateY(-4px);
    box-shadow: 0 12px 30px rgb(20 20 20 / 0.08);
  }

  .chapter-media {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--color-border);
  }

  .chapter-media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s cubic-bezier(0.2, 0.6, 0.2, 1);
  }

  .chapter:hover .chapter-media :global(img) {
    transform: scale(1.05);
  }

  .num {
    position: absolute;
    top: var(--space-2);
    left: var(--space-2);
    color: #fff;
    text-shadow: 0 1px 8px rgb(0 0 0 / 0.5);
  }

  .chapter-body {
    padding: var(--space-3);
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    flex: 1;
  }

  .chapter-body h3 {
    font-size: var(--text-h3);
  }

  .chapter-body p {
    color: var(--color-text-muted);
    flex: 1;
  }

  .pill {
    align-self: flex-start;
    margin-top: var(--space-2);
    font-weight: var(--weight-bold);
    font-size: var(--text-meta);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 0.4rem 1rem;
    border-radius: 999px;
    background: var(--color-text);
    color: var(--color-bg);
    transition: background 0.2s, color 0.2s;
  }

  .chapter:hover .pill {
    background: var(--color-accent);
    color: var(--color-text);
  }

  /* ---------- Referenze & background ----------
     Banda a tutta larghezza in lime tenue: la sezione più "umana" della
     pagina non resta bianca e spoglia. Schede bianche sopra, dati su scuro. */
  section.background {
    width: 100vw;
    margin-left: 50%;
    transform: translateX(-50vw);
    background:
      radial-gradient(60rem 30rem at 85% 0%, rgb(198 255 61 / 0.55), transparent 70%),
      color-mix(in srgb, var(--color-accent) 26%, var(--color-bg));
  }

  .bg-inner {
    max-width: var(--content-max-width);
    margin: 0 auto;
    padding: var(--space-12) var(--space-4);
  }

  .background h2 {
    font-size: var(--text-h2);
    letter-spacing: -0.02em;
  }

  .testimonial-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-3);
    margin-top: var(--space-4);
    padding-top: var(--space-2);
  }

  .facts {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }

  .fact-block {
    padding: var(--space-4);
    border-radius: 1.25rem;
    background: var(--color-text);
    color: var(--color-bg);
  }

  .fact-block h3 {
    font-size: var(--text-meta);
    font-weight: var(--weight-bold);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-accent);
    margin-bottom: var(--space-2);
  }

  .fact-block ul,
  .fact-block ol {
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.5rem;
  }

  .fact-block ul {
    list-style: none;
  }

  .gallup {
    list-style: none;
    counter-reset: g;
  }

  .gallup li {
    counter-increment: g;
    font-size: var(--text-h3);
    font-weight: var(--weight-bold);
  }

  .gallup li::before {
    content: '0' counter(g);
    font-size: var(--text-meta);
    color: var(--color-accent);
    margin-right: 0.8rem;
    vertical-align: middle;
  }

  /* ---------- Contact band ---------- */
  .contact-band {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    flex-wrap: wrap;
    border-top: 1px solid var(--color-text);
    max-width: var(--content-max-width);
    margin: 0 auto;
    padding: var(--space-6) var(--space-4) var(--space-8);
  }

  .contact-band h2 {
    font-size: var(--text-h1);
    letter-spacing: -0.01em;
  }

  @media (max-width: 900px) {
    .chapter-list {
      grid-template-columns: 1fr;
    }


    .testimonial-grid,
    .facts {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .chapter,
    .chapter-media :global(img),
    .cta.primary {
      transition: none;
      animation: none;
    }
  }
</style>
