---
// Home a storytelling verticale: dopo gli user test l'obiettivo è invitare
// esplicitamente ad approfondire (pulsanti visibili + narrazione a capitoli).
// Flusso: hero (ruolo leggibile) → 3 capitoli-categoria con descrizione e
// pulsante → caso studio in evidenza → marquee → referenze & background → CTA.
import { Image } from 'astro:assets';
import TestimonialCard from '../components/TestimonialCard.astro';
import ModelViewer from '../components/ModelViewer.astro';
import Marquee from '../components/Marquee.astro';
import { getCollection } from 'astro:content';
import { getProjectAsset } from '../lib/images';
import { getProjectCopy } from '../lib/content';
import { profile } from '../lib/profile';
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const testimonials = await getCollection('testimonials');

// Capitoli-categoria: immagine, descrizione, pulsante -> ancora in Progetti
const CATEGORIES = [
  { key: 'servizi', image: getProjectAsset('safe-to-work', 'hero.webp') },
  { key: 'prodotti', image: getProjectAsset('cartesio', 'hero.webp') },
  { key: 'spazi', image: getProjectAsset('talea', 'hero.webp') },
] as const;

// Caso studio in evidenza: Hum.us
const featuredImage = getProjectAsset('humus', 'boxes-showcase.webp');
const featuredCopy = await getProjectCopy('humus', lang);

const MARQUEE_ITEMS = ['Six Sigma', 'DMAIC', 'QFD', 'Kano', 'TRIZ', 'Service Design', 'VRED', 'Blender'];
---

<section class="hero">
  <video src="/videos/hero-talea.mp4" autoplay muted loop playsinline aria-hidden="true"></video>
  <div class="overlay">
    <p class="eyebrow reveal">{t('home.eyebrow')}</p>
    <h1 class="role reveal" style="--delay: 100ms">{t('home.role')}</h1>
    <div class="cta-row reveal" style="--delay: 220ms">
      <a class="cta primary" href={`/${lang}/projects/`}>{t('home.cta.projects')} →</a>
      <a class="cta ghost" href={`/${lang}/contact/`}>{t('home.cta.contact')}</a>
    </div>
    <span class="scroll-hint reveal" style="--delay: 340ms">{t('home.scroll')} ↓</span>
  </div>
</section>

<section class="chapters">
  <h2 class="chapters-title reveal">{t('home.chapters')}</h2>
  <div class="chapter-list">
    {
      CATEGORIES.map((cat, i) => (
        <a class="chapter reveal" style={`--delay: ${i * 90}ms`} href={`/${lang}/projects/#${cat.key}`}>
          <div class="chapter-media">
            {cat.image && (
              <Image src={cat.image} alt={t(`cat.${cat.key}`)} widths={[480, 800, 1200]} sizes="(max-width: 900px) 100vw, 33vw" />
            )}
            <span class="num meta-tag">0{i + 1}</span>
          </div>
          <div class="chapter-body">
            <h3>{t(`cat.${cat.key}`)}</h3>
            <p>{t(`cat.${cat.key}.desc`)}</p>
            <span class="pill">{t('home.cta.explore')} →</span>
          </div>
        </a>
      ))
    }
  </div>
</section>

<section class="featured reveal">
  <a class="featured-inner" href={`/${lang}/projects/humus/`}>
    <div class="featured-media">
      {featuredImage && (
        <Image src={featuredImage} alt="Hum.us" widths={[640, 1200, 1800]} sizes="(max-width: 900px) 100vw, 60vw" />
      )}
    </div>
    <div class="featured-text">
      <p class="eyebrow">{t('featured.eyebrow')}</p>
      <h2>{featuredCopy?.data.title ?? 'Hum.us'}</h2>
      <p class="lead">{t('featured.line')}</p>
      <span class="cta primary">{t('featured.cta')} →</span>
    </div>
  </a>
</section>

<Marquee items={MARQUEE_ITEMS} />

<section class="background" id="background">
  <h2 class="reveal">{t('background.title')}</h2>

  <div class="testimonial-grid">
    {testimonials.map((tst, i) => (
      <div class="reveal" style={`--delay: ${i * 80}ms`}>
        <TestimonialCard testimonial={tst} />
      </div>
    ))}
  </div>

  <div class="bg-grid">
    <div class="menu-3d reveal">
      <ModelViewer src="/models/home/menu.glb" alt={t('background.menu')} lang={lang} variant="hero" />
      <p class="meta-tag">{t('background.menu')}</p>
      <a class="cta small" href={profile.cvPath} download>{t('background.cv')} ↓</a>
    </div>
    <div class="facts reveal" style="--delay: 120ms">
      <div class="fact-block">
        <h3 class="meta-tag">{t('speed.title')}</h3>
        <ul class="speed">
          <li>
            <strong>{t('speed.interiors')}</strong>
            <span>{t('speed.interiors.desc')}</span>
            <span class="days meta-tag">7 {t('speed.days')}</span>
          </li>
          <li>
            <strong>{t('speed.identity')}</strong>
            <span>{t('speed.identity.desc')}</span>
            <span class="days meta-tag">12 {t('speed.days')}</span>
          </li>
        </ul>
      </div>
      <div class="fact-block">
        <h3 class="meta-tag">{t('background.languages')}</h3>
        <ul>
          {profile.languages.map((l) => <li>{l}</li>)}
        </ul>
      </div>
      <div class="fact-block">
        <h3 class="meta-tag">{t('background.gallup')}</h3>
        <ul>
          {profile.gallupTop.map((g, i) => <li>{i + 1}. {g}</li>)}
        </ul>
      </div>
    </div>
  </div>
</section>

<section class="contact-band reveal">
  <h2>{t('home.cta.contact')}</h2>
  <a class="cta primary" href={`/${lang}/contact/`}>{t('nav.contact')} →</a>
</section>

<style>
  /* ---------- Hero ---------- */
  .hero {
    position: relative;
    min-height: 84vh;
    overflow: hidden;
    display: flex;
    align-items: flex-end;
  }

  .hero video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .overlay {
    position: relative;
    width: 100%;
    padding: var(--space-6) var(--space-4);
    background: linear-gradient(to top, rgb(20 20 20 / 0.7), rgb(20 20 20 / 0.15) 60%, transparent);
    color: #fff;
  }

  .eyebrow {
    font-size: var(--text-meta);
    font-weight: var(--weight-bold);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    margin-bottom: var(--space-2);
  }

  /* Ruolo: ora è il testo principale della hero, leggibile (non il claim). */
  .role {
    font-size: var(--text-display-small);
    font-weight: var(--weight-bold);
    line-height: 1.08;
    letter-spacing: -0.01em;
    max-width: 20ch;
    text-shadow: 0 2px 30px rgb(0 0 0 / 0.35);
  }

  .cta-row {
    display: flex;
    gap: var(--space-2);
    margin-top: var(--space-4);
    flex-wrap: wrap;
  }

  .cta {
    font-weight: var(--weight-bold);
    border: 1px solid currentColor;
    padding: 0.75rem 1.5rem;
    border-radius: 999px;
    transition: background 0.2s, color 0.2s, border-color 0.2s, transform 0.2s;
  }

  .cta.primary {
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: var(--color-text);
  }

  .cta.primary:hover {
    transform: translateY(-2px);
  }

  .cta.ghost:hover {
    background: #fff;
    color: var(--color-text);
  }

  .scroll-hint {
    display: block;
    margin-top: var(--space-4);
    font-size: var(--text-meta);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    opacity: 0.85;
    animation: bob 2.4s ease-in-out infinite;
  }

  @keyframes bob {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(4px); }
  }

  /* ---------- Capitoli / categorie ---------- */
  .chapters {
    max-width: var(--content-max-width);
    margin: 0 auto;
    padding: var(--space-8) var(--space-4) var(--space-6);
  }

  .chapters-title {
    font-size: var(--text-h2);
    letter-spacing: -0.01em;
    margin-bottom: var(--space-4);
  }

  .chapter-list {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-4);
  }

  .chapter {
    display: flex;
    flex-direction: column;
    color: var(--color-text);
    border: 1px solid var(--color-border);
    border-radius: 14px;
    overflow: hidden;
    transition: border-color 0.25s, transform 0.25s, box-shadow 0.25s;
  }

  .chapter:hover {
    border-color: var(--color-accent);
    transform: translateY(-4px);
    box-shadow: 0 12px 30px rgb(20 20 20 / 0.08);
  }

  .chapter-media {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--color-border);
  }

  .chapter-media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s cubic-bezier(0.2, 0.6, 0.2, 1);
  }

  .chapter:hover .chapter-media :global(img) {
    transform: scale(1.05);
  }

  .num {
    position: absolute;
    top: var(--space-2);
    left: var(--space-2);
    color: #fff;
    text-shadow: 0 1px 8px rgb(0 0 0 / 0.5);
  }

  .chapter-body {
    padding: var(--space-3);
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    flex: 1;
  }

  .chapter-body h3 {
    font-size: var(--text-h3);
  }

  .chapter-body p {
    color: var(--color-text-muted);
    flex: 1;
  }

  .pill {
    align-self: flex-start;
    margin-top: var(--space-2);
    font-weight: var(--weight-bold);
    font-size: var(--text-meta);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 0.4rem 1rem;
    border-radius: 999px;
    background: var(--color-text);
    color: var(--color-bg);
    transition: background 0.2s, color 0.2s;
  }

  .chapter:hover .pill {
    background: var(--color-accent);
    color: var(--color-text);
  }

  /* ---------- Caso studio in evidenza ---------- */
  .featured {
    max-width: var(--content-max-width);
    margin: 0 auto;
    padding: var(--space-6) var(--space-4);
  }

  .featured-inner {
    display: grid;
    grid-template-columns: 7fr 5fr;
    gap: var(--space-4);
    align-items: center;
    color: var(--color-text);
    background: color-mix(in srgb, var(--color-accent) 10%, var(--color-bg));
    border: 1px solid color-mix(in srgb, var(--color-accent) 40%, var(--color-bg));
    border-radius: 16px;
    overflow: hidden;
  }

  .featured-media {
    aspect-ratio: 16 / 11;
    overflow: hidden;
  }

  .featured-media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.2, 0.6, 0.2, 1);
  }

  .featured-inner:hover .featured-media :global(img) {
    transform: scale(1.03);
  }

  .featured-text {
    padding: var(--space-4) var(--space-4) var(--space-4) 0;
  }

  .featured-text .eyebrow {
    color: var(--color-text-muted);
    margin-bottom: var(--space-1);
  }

  .featured-text h2 {
    font-size: var(--text-h1);
    letter-spacing: -0.02em;
    line-height: 1;
  }

  .featured-text .lead {
    margin: var(--space-2) 0 var(--space-3);
    color: var(--color-text-muted);
    font-size: var(--text-h3);
    font-weight: var(--weight-light);
  }

  .featured-text .cta {
    display: inline-block;
  }

  /* ---------- Referenze & background ---------- */
  section.background {
    padding: var(--space-8) var(--space-4);
    max-width: var(--content-max-width);
    margin: 0 auto;
  }

  .background h2 {
    font-size: var(--text-h2);
  }

  .testimonial-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-3);
    margin-top: var(--space-3);
  }

  .bg-grid {
    display: grid;
    grid-template-columns: 5fr 7fr;
    gap: var(--space-6);
    margin-top: var(--space-6);
    align-items: start;
  }

  .facts {
    display: grid;
    gap: var(--space-4);
    background: color-mix(in srgb, var(--color-accent) 14%, var(--color-bg));
    border: 1px solid color-mix(in srgb, var(--color-accent) 45%, var(--color-bg));
    border-radius: 12px;
    padding: var(--space-4);
  }

  .fact-block h3 {
    border-bottom: 2px solid var(--color-accent);
    padding-bottom: var(--space-1);
    margin-bottom: var(--space-2);
    color: var(--color-text);
  }

  .fact-block ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.4rem;
  }

  .speed li {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: var(--space-2);
    align-items: baseline;
  }

  .speed .days {
    background: var(--color-accent);
    color: var(--color-text);
    padding: 0.1rem 0.6rem;
    border-radius: 999px;
    white-space: nowrap;
  }

  .cta.small {
    display: inline-block;
    margin-top: var(--space-2);
    padding: 0.5rem 1.1rem;
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: var(--color-text);
  }

  /* ---------- Contact band ---------- */
  .contact-band {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    flex-wrap: wrap;
    border-top: 1px solid var(--color-text);
    max-width: var(--content-max-width);
    margin: 0 auto;
    padding: var(--space-6) var(--space-4) var(--space-8);
  }

  .contact-band h2 {
    font-size: var(--text-h1);
    letter-spacing: -0.01em;
  }

  @media (max-width: 900px) {
    .chapter-list {
      grid-template-columns: 1fr;
    }

    .featured-inner {
      grid-template-columns: 1fr;
    }

    .featured-text {
      padding: 0 var(--space-4) var(--space-4);
    }

    .testimonial-grid {
      grid-template-columns: 1fr;
    }

    .bg-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .chapter,
    .chapter-media :global(img),
    .featured-media :global(img),
    .cta.primary,
    .scroll-hint {
      transition: none;
      animation: none;
    }
  }
</style>
