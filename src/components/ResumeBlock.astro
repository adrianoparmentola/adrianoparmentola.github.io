---
// Subito sotto il profilo: il menù-portfolio in 3D da girare e il CV da
// scaricare. Due oggetti, niente testo di contorno.
import ModelViewer from './ModelViewer.astro';
import { profile } from '../lib/profile';
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="resume">
  <div class="menu reveal">
    <ModelViewer src="/models/home/menu.glb" alt={t('background.menu')} lang={lang} variant="hero" />
    <p class="caption">{t('background.menu')}</p>
  </div>

  <a class="cv reveal" href={profile.cvPath} download style="--delay: 120ms">
    <span class="cv-big" aria-hidden="true">CV</span>
    <span class="cv-foot">
      <span class="cv-label">{t('background.cv')}</span>
      <span class="cv-arrow" aria-hidden="true">↓</span>
    </span>
  </a>
</section>

<style>
  .resume {
    max-width: var(--content-max-width);
    margin: 0 auto;
    padding: var(--space-8) var(--space-4) var(--space-12);
    display: grid;
    grid-template-columns: 7fr 5fr;
    gap: var(--space-4);
    align-items: stretch;
  }

  .menu {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .caption {
    font-size: var(--text-meta);
    font-weight: var(--weight-bold);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-text-muted);
  }

  /* il CV come oggetto: un blocco scuro con due lettere enormi */
  .cv {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 22rem;
    padding: var(--space-4);
    border-radius: 1.5rem;
    background: var(--color-text);
    color: var(--color-bg);
    overflow: hidden;
    transition: transform 0.4s cubic-bezier(0.3, 0.9, 0.3, 1);
  }

  .cv:hover {
    transform: translateY(-4px);
    color: var(--color-bg);
  }

  .cv-big {
    font-size: clamp(7rem, 4rem + 10vw, 14rem);
    font-weight: var(--weight-bold);
    line-height: 0.8;
    letter-spacing: -0.06em;
  }

  .cv-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
  }

  .cv-label {
    font-size: var(--text-meta);
    font-weight: var(--weight-bold);
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }

  .cv-arrow {
    display: grid;
    place-items: center;
    width: 3.4rem;
    height: 3.4rem;
    border-radius: 50%;
    background: var(--color-accent);
    color: var(--color-text);
    font-size: 1.3rem;
    font-weight: var(--weight-bold);
    transition: transform 0.35s cubic-bezier(0.3, 0.9, 0.3, 1);
  }

  .cv:hover .cv-arrow,
  .cv:focus-visible .cv-arrow {
    transform: translateY(4px);
  }

  @media (max-width: 900px) {
    .resume {
      grid-template-columns: 1fr;
    }

    .cv {
      min-height: 16rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cv,
    .cv-arrow {
      transition: none;
    }
  }
</style>
