---
// Titolo di sezione lettera per lettera: sullo scroll ogni lettera risale dal
// basso con un piccolo ritardo e una rotazione, e si ricompone (effetto
// "ABOUT ME" della reference). Scrubbato: tornando su, le lettere ricadono.
// Il movimento vive in src/scripts/scrollfx.ts.
//  size="xl"  una parola gigante centrata (es. "Progetti")
//  size="md"  titolo più contenuto, allineato a sinistra, va a capo per parole
interface Props {
  text: string;
  tone?: 'light' | 'dark';
  size?: 'xl' | 'md';
}

const { text, tone = 'light', size = 'xl' } = Astro.props;
const words = text.split(' ');
let n = 0;
---

<h2 class:list={['split-title', tone, size]} aria-label={text}>
  <span class="line" aria-hidden="true">
    {
      words.map((word) => (
        <span class="word">
          {[...word].map((c) => (
            <span class="st-ch" style={`--i:${n++}`}>
              {c}
            </span>
          ))}
        </span>
      ))
    }
  </span>
</h2>

<style>
  .split-title {
    margin: 0;
    font-weight: var(--weight-bold);
    color: var(--color-text);
    /* le lettere entrano da sotto la riga: quel che sta sotto non si vede */
    overflow: hidden;
    padding-bottom: 0.06em;
  }

  .split-title.dark {
    color: var(--color-bg);
  }

  .xl {
    padding-inline: var(--space-2);
    text-align: center;
    font-size: clamp(3.5rem, 1rem + 13vw, 15rem);
    line-height: 0.82;
    letter-spacing: -0.055em;
    text-transform: uppercase;
  }

  .md {
    font-size: clamp(2.6rem, 1.2rem + 5.2vw, 6.4rem);
    line-height: 0.92;
    letter-spacing: -0.04em;
  }

  .line {
    display: inline;
  }

  .xl .line {
    white-space: nowrap;
  }

  .word {
    display: inline-block;
    white-space: nowrap;
    overflow: hidden;
    padding-bottom: 0.06em;
    margin-right: 0.24em;
  }

  .word:last-child {
    margin-right: 0;
  }

  .st-ch {
    display: inline-block;
    will-change: transform;
    transform-origin: 50% 100%;
  }
</style>
